<Window x:Class="YuanShenTools.BookmarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="书签" Height="300" Width="350"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        Topmost="True">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="AddButton" Content="添加" Width="50" Margin="4,0,0,0" Click="AddButton_Click"/>
            <TextBox x:Name="NewUrlTextBox" FontSize="13"/>
        </DockPanel>
        <ListBox x:Name="BookmarkList" Grid.Row="1" DisplayMemberPath="Title"
                 SelectionMode="Single" MouseDoubleClick="BookmarkList_MouseDoubleClick"/>
        <Button x:Name="DeleteButton" Grid.Row="2" Content="删除选中" Margin="0,8,0,0" Click="DeleteButton_Click"/>
    </Grid>
</Window>