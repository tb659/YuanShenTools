<Window x:Class="YuanShenTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="原神跟跑" Height="360" Width="480"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        Opacity="0.6"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#333333" Cursor="SizeAll" MouseLeftButtonDown="LegendGrid_MouseDown">
            <TextBlock x:Name="LegendText" Text="` 播放/暂停 | 5 后退10s | 6 前进10s | 7 透明度- | 8 透明度+ | 9 隐藏 | 0 沉浸 关 | - 跳过 | + 书签"
                       Foreground="#AAAAAA" FontSize="11" Margin="6,6,6,2" TextTrimming="CharacterEllipsis"/>
        </Grid>

        <Grid Grid.Row="1" Background="#333333">
            <DockPanel Margin="4,2" LastChildFill="True">
                <Button DockPanel.Dock="Right" x:Name="CloseButton" Content="✕" Width="22" Margin="2,0,0,0" Click="CloseButton_Click"
                        Background="#555555" Foreground="White" BorderThickness="0" FontSize="11"/>
                <Button DockPanel.Dock="Right" x:Name="MaxButton" Content="□" Width="20" Margin="2,0,0,0" Click="MaxButton_Click"
                        Background="#333333" Foreground="White" BorderThickness="0" FontSize="10"/>
                <Button DockPanel.Dock="Right" x:Name="MinButton" Content="—" Width="20" Margin="2,0,0,0" Click="MinButton_Click"
                        Background="#333333" Foreground="White" BorderThickness="0" FontSize="10"/>
                <Button DockPanel.Dock="Right" x:Name="GoButton" Content="Go" Width="36" Margin="2,0,0,0" Click="GoButton_Click"
                        Background="#555555" Foreground="White" BorderThickness="0"/>
                <TextBox x:Name="UrlTextBox" Text="https://www.bilibili.com" 
                         FontSize="13" BorderThickness="0"
                         Background="#222222" Foreground="White"
                         KeyDown="UrlTextBox_KeyDown"/>
            </DockPanel>
        </Grid>
        <Grid Grid.Row="2" Background="#151515"
              MouseDown="WebViewGrid_MouseDown"
              MouseWheel="WebViewGrid_MouseWheel"
              MouseMove="WebViewGrid_MouseMove"
              Cursor="Arrow">
            <wv2:WebView2 x:Name="WebView" Margin="6,0,6,6"/>
        </Grid>

        <Rectangle Grid.RowSpan="3" Name="ResizeTop" Height="6" VerticalAlignment="Top" Fill="#151515"
                   Cursor="SizeNS" MouseLeftButtonDown="ResizeMouseDown"/>
        <Rectangle Grid.RowSpan="3" Name="ResizeBottom" Height="6" VerticalAlignment="Bottom" Fill="#151515"
                   Cursor="SizeNS" MouseLeftButtonDown="ResizeMouseDown"/>
        <Rectangle Grid.RowSpan="3" Name="ResizeLeft" Width="6" HorizontalAlignment="Left" Fill="#151515"
                   Cursor="SizeWE" MouseLeftButtonDown="ResizeMouseDown"/>
        <Rectangle Grid.RowSpan="3" Name="ResizeRight" Width="6" HorizontalAlignment="Right" Fill="#151515"
                   Cursor="SizeWE" MouseLeftButtonDown="ResizeMouseDown"/>
        <Rectangle Grid.RowSpan="3" Name="ResizeTopLeft" Width="12" Height="12" VerticalAlignment="Top" HorizontalAlignment="Left"
                   Fill="#151515" Cursor="SizeNWSE" MouseLeftButtonDown="ResizeMouseDown"/>
        <Rectangle Grid.RowSpan="3" Name="ResizeTopRight" Width="12" Height="12" VerticalAlignment="Top" HorizontalAlignment="Right"
                   Fill="#151515" Cursor="SizeNESW" MouseLeftButtonDown="ResizeMouseDown"/>
        <Rectangle Grid.RowSpan="3" Name="ResizeBottomLeft" Width="12" Height="12" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                   Fill="#151515" Cursor="SizeNESW" MouseLeftButtonDown="ResizeMouseDown"/>
        <Rectangle Grid.RowSpan="3" Name="ResizeBottomRight" Width="12" Height="12" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                   Fill="#151515" Cursor="SizeNWSE" MouseLeftButtonDown="ResizeMouseDown"/>

        <Grid Grid.RowSpan="3" x:Name="BookmarkOverlay" Visibility="Collapsed" Background="#000000">
            <Border Background="#2D2D2D" Padding="16" Width="280" MaxHeight="300"
                    HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button Content="添加" Width="50" Margin="4,0,0,0"
                                Background="#444444" Foreground="White" BorderThickness="0"
                                Click="BookmarkAdd_Click"/>
                        <TextBox x:Name="BookmarkUrlTextBox" FontSize="13"
                                 Background="#222222" Foreground="White" BorderThickness="0"/>
                    </DockPanel>
                    <ListBox x:Name="BookmarkListBox" Grid.Row="1"
                             SelectionMode="Single" MouseDoubleClick="BookmarkList_DoubleClick"
                             Background="#111111" Foreground="White" BorderThickness="0"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Content="删除" Width="60" Margin="0,0,8,0" Click="BookmarkDelete_Click"
                                Background="#444444" Foreground="White" BorderThickness="0"/>
                        <Button Content="关闭" Width="60" Click="BookmarkClose_Click"
                                Background="#444444" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>