<Window x:Class="YuanShenTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="原神跟跑" Height="360" Width="480"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        Opacity="0.6"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#55000000">
            <TextBlock Text="` 播放/暂停 | 5 后退10s | 6 前进10s | 7 透明度- | 8 透明度+ | 9 隐藏 | 0 书签 | - 跳过对话"
                       Foreground="#AAAAAA" FontSize="11" Margin="6,2" TextTrimming="CharacterEllipsis"/>
        </Grid>

        <Grid Grid.Row="1" Background="#66000000">
            <DockPanel Margin="4,2">
                <Border Width="24" MouseLeftButtonDown="DragBar_MouseDown" Cursor="SizeAll"
                        Background="#88000000" Margin="0,0,2,0">
                    <TextBlock Text="⠿" Foreground="#888888" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Button x:Name="MinButton" Content="—" Width="22" Margin="2,0,0,0" Click="MinButton_Click"
                        Background="#66000000" Foreground="White" BorderThickness="0" FontSize="11"/>
                <Button x:Name="MaxButton" Content="□" Width="22" Margin="2,0,0,0" Click="MaxButton_Click"
                        Background="#66000000" Foreground="White" BorderThickness="0" FontSize="11"/>
                <Button x:Name="GoButton" Content="Go" Width="40" Margin="2,0,0,0" Click="GoButton_Click"
                        Background="#88000000" Foreground="White" BorderThickness="0"/>
                <TextBox x:Name="UrlTextBox" Text="https://www.bilibili.com" 
                         FontSize="13" BorderThickness="0"
                         Background="#66000000" Foreground="White"
                         KeyDown="UrlTextBox_KeyDown"/>
            </DockPanel>
        </Grid>
        <Grid Grid.Row="2" Background="#40000000"
              MouseDown="WebViewGrid_MouseDown"
              MouseWheel="WebViewGrid_MouseWheel"
              MouseMove="WebViewGrid_MouseMove"
              Cursor="Arrow">
            <wv2:WebView2 x:Name="WebView" Margin="6,0,6,6"/>
        </Grid>

        <Rectangle Grid.RowSpan="3" Name="ResizeTop" Height="6" VerticalAlignment="Top" Fill="#40000000"
                   Cursor="SizeNS" MouseLeftButtonDown="ResizeMouseDown"/>
        <Rectangle Grid.RowSpan="3" Name="ResizeBottom" Height="6" VerticalAlignment="Bottom" Fill="#40000000"
                   Cursor="SizeNS" MouseLeftButtonDown="ResizeMouseDown"/>
        <Rectangle Grid.RowSpan="3" Name="ResizeLeft" Width="6" HorizontalAlignment="Left" Fill="#40000000"
                   Cursor="SizeWE" MouseLeftButtonDown="ResizeMouseDown"/>
        <Rectangle Grid.RowSpan="3" Name="ResizeRight" Width="6" HorizontalAlignment="Right" Fill="#40000000"
                   Cursor="SizeWE" MouseLeftButtonDown="ResizeMouseDown"/>
        <Rectangle Grid.RowSpan="3" Name="ResizeTopLeft" Width="12" Height="12" VerticalAlignment="Top" HorizontalAlignment="Left"
                   Fill="#40000000" Cursor="SizeNWSE" MouseLeftButtonDown="ResizeMouseDown"/>
        <Rectangle Grid.RowSpan="3" Name="ResizeTopRight" Width="12" Height="12" VerticalAlignment="Top" HorizontalAlignment="Right"
                   Fill="#40000000" Cursor="SizeNESW" MouseLeftButtonDown="ResizeMouseDown"/>
        <Rectangle Grid.RowSpan="3" Name="ResizeBottomLeft" Width="12" Height="12" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                   Fill="#40000000" Cursor="SizeNESW" MouseLeftButtonDown="ResizeMouseDown"/>
        <Rectangle Grid.RowSpan="3" Name="ResizeBottomRight" Width="12" Height="12" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                   Fill="#40000000" Cursor="SizeNWSE" MouseLeftButtonDown="ResizeMouseDown"/>
    </Grid>
</Window>